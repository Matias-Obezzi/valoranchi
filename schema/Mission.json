{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Mission",
  "definitions": {
    "Mission": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "progress": {
          "type": "number"
        },
        "target": {
          "type": "number"
        },
        "complete": {
          "type": "boolean"
        },
        "expiresAt": {
          "type": ["string", "null"]
        }
      },
      "required": ["uuid", "title", "progress", "target", "complete", "expiresAt"],
      "additionalProperties": false
    }
  }
}
