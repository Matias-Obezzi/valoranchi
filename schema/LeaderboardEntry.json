{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LeaderboardEntry",
  "definitions": {
    "LeaderboardEntry": {
      "type": "object",
      "properties": {
        "rank": {
          "type": "number"
        },
        "puuid": {
          "type": "string"
        },
        "gameName": {
          "type": "string"
        },
        "tagLine": {
          "type": "string"
        },
        "anonymized": {
          "type": "boolean"
        },
        "banned": {
          "type": "boolean"
        },
        "rating": {
          "type": "number"
        },
        "wins": {
          "type": "number"
        },
        "tier": {
          "$ref": "#/definitions/Rank"
        }
      },
      "required": [
        "rank",
        "puuid",
        "gameName",
        "tagLine",
        "anonymized",
        "banned",
        "rating",
        "wins",
        "tier"
      ],
      "additionalProperties": false
    },
    "Rank": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "division": {
          "type": ["string", "null"]
        },
        "icon": {
          "$ref": "#/definitions/Image"
        },
        "rating": {
          "type": ["number", "null"]
        }
      },
      "required": ["tier", "name", "division", "icon", "rating"],
      "additionalProperties": false
    },
    "Image": {
      "type": ["string", "null"]
    }
  }
}
