{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CustomGameConfigs",
  "definitions": {
    "CustomGameConfigs": {
      "type": "object",
      "properties": {
        "maps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["path", "name"],
            "additionalProperties": false
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["path", "name"],
            "additionalProperties": false
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "ping": {
                "type": ["number", "null"]
              }
            },
            "required": ["id", "name", "ping"],
            "additionalProperties": false
          }
        }
      },
      "required": ["maps", "modes", "servers"],
      "additionalProperties": false
    }
  }
}
