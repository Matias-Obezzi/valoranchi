{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/MatchSummary",
  "definitions": {
    "MatchSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "queue": {
          "type": "string"
        },
        "map": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": ["string", "null"]
            },
            "name": {
              "type": ["string", "null"]
            },
            "path": {
              "type": "string"
            }
          },
          "required": ["uuid", "name", "path"],
          "additionalProperties": false
        }
      },
      "required": ["id", "startedAt", "queue", "map"],
      "additionalProperties": false
    }
  }
}
