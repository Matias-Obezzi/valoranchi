{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Player",
  "definitions": {
    "Player": {
      "type": "object",
      "properties": {
        "puuid": {
          "type": "string"
        },
        "gameName": {
          "type": "string"
        },
        "tagLine": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "shard": {
          "type": "string"
        },
        "accountLevel": {
          "type": "number"
        }
      },
      "required": ["puuid", "gameName", "tagLine", "region", "shard", "accountLevel"],
      "additionalProperties": false
    }
  }
}
