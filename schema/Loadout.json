{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Loadout",
  "definitions": {
    "Loadout": {
      "type": "object",
      "properties": {
        "player": {
          "$ref": "#/definitions/Player"
        },
        "guns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoadoutGun"
          }
        },
        "sprays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string"
              },
              "uuid": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "$ref": "#/definitions/Image"
              }
            },
            "required": ["slot", "uuid", "name", "icon"],
            "additionalProperties": false
          }
        },
        "flex": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "uuid": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "icon": {
                  "$ref": "#/definitions/Image"
                }
              },
              "required": ["uuid", "name", "icon"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/definitions/OwnedCard"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/definitions/OwnedTitle"
            },
            {
              "type": "null"
            }
          ]
        },
        "incognito": {
          "type": "boolean"
        }
      },
      "required": ["player", "guns", "sprays", "flex", "card", "title", "incognito"],
      "additionalProperties": false
    },
    "Player": {
      "type": "object",
      "properties": {
        "puuid": {
          "type": "string"
        },
        "gameName": {
          "type": "string"
        },
        "tagLine": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "shard": {
          "type": "string"
        },
        "accountLevel": {
          "type": "number"
        }
      },
      "required": ["puuid", "gameName", "tagLine", "region", "shard", "accountLevel"],
      "additionalProperties": false
    },
    "LoadoutGun": {
      "type": "object",
      "properties": {
        "weapon": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["uuid", "name"],
          "additionalProperties": false
        },
        "skin": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "icon": {
              "$ref": "#/definitions/Image"
            }
          },
          "required": ["uuid", "name", "icon"],
          "additionalProperties": false
        },
        "level": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["uuid", "name"],
          "additionalProperties": false
        },
        "chroma": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": ["uuid", "name"],
          "additionalProperties": false
        },
        "buddy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "uuid": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "icon": {
                  "$ref": "#/definitions/Image"
                }
              },
              "required": ["uuid", "name", "icon"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["weapon", "skin", "level", "chroma", "buddy"],
      "additionalProperties": false
    },
    "Image": {
      "type": ["string", "null"]
    },
    "OwnedCard": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "small": {
          "$ref": "#/definitions/Image"
        },
        "wide": {
          "$ref": "#/definitions/Image"
        },
        "large": {
          "$ref": "#/definitions/Image"
        }
      },
      "required": ["uuid", "name", "small", "wide", "large"],
      "additionalProperties": false
    },
    "OwnedTitle": {
      "type": "object",
      "properties": {
        "uuid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": ["string", "null"]
        }
      },
      "required": ["uuid", "name", "text"],
      "additionalProperties": false
    }
  }
}
