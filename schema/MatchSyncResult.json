{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/MatchSyncResult",
  "definitions": {
    "MatchSyncResult": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MatchSummary"
          }
        },
        "total": {
          "type": "number"
        }
      },
      "required": ["added", "total"],
      "additionalProperties": false
    },
    "MatchSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "queue": {
          "type": "string"
        },
        "map": {
          "type": "object",
          "properties": {
            "uuid": {
              "type": ["string", "null"]
            },
            "name": {
              "type": ["string", "null"]
            },
            "path": {
              "type": "string"
            }
          },
          "required": ["uuid", "name", "path"],
          "additionalProperties": false
        }
      },
      "required": ["id", "startedAt", "queue", "map"],
      "additionalProperties": false
    }
  }
}
